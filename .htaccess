# Debug-Modus für PHP aktivieren (Umgebungsvariable für sendmail.php)
# SetEnv DERKO_DEBUG 1
# .htaccess — security, performance, and SEO rewrites

# Disable MultiViews (content negotiation) to avoid rewrite surprises
Options -MultiViews

<IfModule mod_setenvif.c>
  # Flag HTTPS so we can conditionally set powerful feature headers only on secure origins
  SetEnvIfNoCase HTTPS on HTTPS_ON=1
</IfModule>

<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Only send the COOP/COEP/CORP trio on HTTPS to avoid Chrome console warnings on http
  Header set Cross-Origin-Opener-Policy "same-origin" env=HTTPS_ON
  Header set Cross-Origin-Resource-Policy "same-origin" env=HTTPS_ON
  Header set Cross-Origin-Embedder-Policy "require-corp" env=HTTPS_ON
  # Disable legacy XSS Auditor (avoid false positives)
  Header set X-XSS-Protection "0"
</IfModule>

# Force HTTPS (optional; enable only if cert available on all hosts)
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} !=on
#  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#</IfModule>

# Correct MIME types for modern images
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# 1. SICHERHEIT: Log-Dateien und Configs sperren (NEU)
# Verhindert, dass jemand error.log oder config.local.php im Browser öffnet
<FilesMatch "\.(log|lock|local\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 2. PERFORMANCE: Browser caching (DEIN ALTER CODE)
<FilesMatch "\.(avif|webp|png|jpe?g|svg|css|js|woff2)$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 30 days"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=2592000, immutable"
  </IfModule>
</FilesMatch>


# Pretty URLs and 301 redirects
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve custom 404 page from /pages without redirects
  ErrorDocument 404 /pages/404.html

  # Do not rewrite the 404 page itself
  RewriteRule ^pages/404\.html$ - [L]

  # --- Canonicalize direct /pages/*.html requests to pretty paths (avoid loops) ---
  # Use THE_REQUEST so only user-entered URLs redirect; internal rewrites won't trigger
  RewriteCond %{THE_REQUEST} \s/+pages/wohnungen\.html [NC]
  RewriteRule ^pages/wohnungen\.html$ /wohnungen [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/kontakt\.html [NC]
  RewriteRule ^pages/kontakt\.html$ /kontakt [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/ueber-uns\.html [NC]
  RewriteRule ^pages/ueber-uns\.html$ /ueber-uns [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/impressum\.html [NC]
  RewriteRule ^pages/impressum\.html$ /impressum [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/agb\.html [NC]
  RewriteRule ^pages/agb\.html$ /agb [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/datenschutz\.html [NC]
  RewriteRule ^pages/datenschutz\.html$ /datenschutz [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/wohnung-detail\.html [NC]
  RewriteRule ^pages/wohnung-detail\.html$ /wohnung [QSA,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/faq\.html [NC]
  RewriteRule ^pages/faq\.html$ /faq [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/bestaetigung\.html [NC]
  RewriteRule ^pages/bestaetigung\.html$ /bestaetigung [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/error-session\.html [NC]
  RewriteRule ^pages/error-session\.html$ /error-session [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/error-captcha\.html [NC]
  RewriteRule ^pages/error-captcha\.html$ /error-captcha [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pages/error-rate-limit\.html [NC]
  RewriteRule ^pages/error-rate-limit\.html$ /error-rate-limit [QSA,R=301,L]

  # Allow extensionless access below /pages (e.g., /pages/kontakt -> /pages/kontakt.html)
  RewriteRule ^pages/([A-Za-z0-9_-]+)/?$ /pages/$1.html [L]

  # If file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Pretty path to pages (German slugs)
  RewriteRule ^$ /index.html [L]
  RewriteRule ^wohnungen/?$ /pages/wohnungen.html [L]
  RewriteRule ^kontakt/?$ /pages/kontakt.html [L]
  RewriteRule ^ueber-uns/?$ /pages/ueber-uns.html [L]
  RewriteRule ^impressum/?$ /pages/impressum.html [L]
  RewriteRule ^agb/?$ /pages/agb.html [L]
  RewriteRule ^datenschutz/?$ /pages/datenschutz.html [L]
  RewriteRule ^bestaetigung/?$ /pages/bestaetigung.html [L]
  RewriteRule ^error-session/?$ /pages/error-session.html [L]
  RewriteRule ^error-captcha/?$ /pages/error-captcha.html [L]
  RewriteRule ^error-rate-limit/?$ /pages/error-rate-limit.html [QSA,L]
  # 301 redirect old ?id= format to clean slug
  RewriteCond %{QUERY_STRING} ^id=w01_derko_apart$
  RewriteRule ^wohnung/?$ /wohnung/w01-derko-apart? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w02_derko_apart_2$
  RewriteRule ^wohnung/?$ /wohnung/w02-derko-apart-2? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w03_exklusiv$
  RewriteRule ^wohnung/?$ /wohnung/w03-exklusiv? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w04_exklusiv_2$
  RewriteRule ^wohnung/?$ /wohnung/w04-exklusiv-2? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w05_dus_1$
  RewriteRule ^wohnung/?$ /wohnung/w05-dus-1? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w06_dus_2$
  RewriteRule ^wohnung/?$ /wohnung/w06-dus-2? [R=301,L]
  RewriteCond %{QUERY_STRING} ^id=w07_dus_3$
  RewriteRule ^wohnung/?$ /wohnung/w07-dus-3? [R=301,L]
  # Detailseite ohne Parameter
  RewriteRule ^wohnung/?$ /pages/wohnung-detail.html [QSA,L]
  # Apartment detail pages (clean slug URLs)
  RewriteRule ^wohnung/([a-z0-9-]+)/?$ /pages/wohnung-detail.html [QSA,L]
  # FAQ
  RewriteRule ^faq/?$ /pages/faq.html [L]

  # Multi-language URL routing: /{lang}/ and /{lang}/{page}
  # Language root pages (e.g. /en/, /pl/)
  RewriteRule ^(en|pl|hu|sk|cs|it|bg|ro)/?$ /index.html [L]
  # Language-prefixed detail pages (preserve query string)
  RewriteRule ^(en|pl|hu|sk|cs|it|bg|ro)/wohnung/?$ /pages/wohnung-detail.html [QSA,L]
  # Language-prefixed apartment detail pages (clean slug URLs)
  RewriteRule ^(en|pl|hu|sk|cs|it|bg|ro)/wohnung/([a-z0-9-]+)/?$ /pages/wohnung-detail.html [QSA,L]
  # Language-prefixed standard pages
  RewriteRule ^(en|pl|hu|sk|cs|it|bg|ro)/(wohnungen|kontakt|ueber-uns|faq|agb|impressum|datenschutz|bestaetigung|error-session|error-captcha|error-rate-limit)/?$ /pages/$2.html [QSA,L]

  # (Replaced RedirectMatch rules with THE_REQUEST-based rules above to prevent redirect loops)
</IfModule>
