node_modules/
.DS_Store
Thumbs.db
dist/

# Sensitive configuration files (use .example templates)
api/config.local.php
api/weekly_mail_config.php
.claude/*
# ...except project skills, which are shared tooling and belong in the repo
!.claude/skills/

# Log files and runtime data
api/*.log
api/*.lock
api/rate_store/

# Runtime session files (directory is tracked via .gitkeep)
tmp/sessions/sess_*

# Token store files (directory is tracked via .gitkeep)
tmp/tokens/*.json

# Environment files (if ever used)
.env
.env.local

# Docker: msmtp config contains no secrets but follows best-practice gitignore
.docker/msmtprc

# Playwright test artifacts (generated, not source)
playwright-report/
playwright-results/
test-results/
